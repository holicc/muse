{
  "name": "muse-studio",
  "productName": "muse",
  "version": "0.1.0",
  "description": "muse 调整与设计窗口",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:ui": "tsc --noEmit && vite build",
    "build": "npm run build:wasm && npm run build:ui",
    "dev": "vite",
    "start": "electron .",
    "dist": "npm run build && node scripts/dist.mjs"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "electron": "43.8.7",
    "electron-builder": "26.0.12",
    "motion": "12.23.24",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  },
  "build": {
    "appId": "dev.muse.studio",
    "productName": "muse",
    "executableName": "muse-studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility",
      "extraResources": [
        {
          "from": "../target/release/muse",
          "to": "bin/muse"
        },
        {
          "from": "../packs",
          "to": "bin/packs"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.lifestyle",
      "extraResources": [
        {
          "from": "../target/release/muse",
          "to": "bin/muse"
        },
        {
          "from": "../packs",
          "to": "bin/packs"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "../target/release/muse.exe",
          "to": "bin/muse.exe"
        },
        {
          "from": "../packs",
          "to": "bin/packs"
        }
      ]
    }
  },
  "author": "muse"
}
